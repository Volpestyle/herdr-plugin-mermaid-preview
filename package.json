{
  "name": "herdr-plugin-mermaid-preview",
  "version": "0.3.0",
  "private": true,
  "description": "Live Mermaid diagram and transcript image previews for Claude Code and Codex in Herdr TUI, Herdr App, and Herdr Browser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Volpestyle/herdr-plugin-mermaid-preview.git"
  },
  "bugs": {
    "url": "https://github.com/Volpestyle/herdr-plugin-mermaid-preview/issues"
  },
  "homepage": "https://github.com/Volpestyle/herdr-plugin-mermaid-preview#readme",
  "type": "module",
  "bin": {
    "herdr-preview": "bin/herdr-preview.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "npm run syntax && npm test",
    "install:all": "node scripts/install-mod.mjs all",
    "install:app": "node scripts/install-mod.mjs app",
    "install:browser": "node scripts/install-mod.mjs browser",
    "syntax": "node --check bin/*.mjs scripts/*.mjs src/*.mjs src/*/*.mjs test/*.test.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@mermaid-js/mermaid-cli": "11.16.0",
    "puppeteer": "25.3.0"
  },
  "allowScripts": {
    "puppeteer@25.3.0": true
  }
}
